generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  shortDescription String
  fullDescription String
  category        String
  technologies    String[]
  githubUrl       String?
  liveUrl         String?
  imageUrl        String?
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  description String
  date        String
  organization String
  link        String?
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Certification {
  id             String   @id @default(cuid())
  title          String
  issuer         String
  issueDate      String
  credentialUrl  String?
  credentialId   String?
  certificateImage String?
  createdAt      DateTime @default(now())
}

model ContactMessage {
  id           String    @id @default(cuid())
  name         String
  email        String
  inquiryType  String    @default("General inquiry")
  subject      String
  message      String
  organization String?
  budgetRange  String?
  timeline     String?
  responseText String?
  createdAt    DateTime  @default(now())
  respondedAt  DateTime?
  status       String    @default("new")
}
